# Jarvis Environment Configuration (Development)

# Service Config
JARVIS_APP_NAME=jarvis-mvp
JARVIS_ENVIRONMENT=local
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000

# Database URLs (overridden in docker-compose for containers)
JARVIS_MONGO_DSN=mongodb://localhost:27017
JARVIS_MONGO_DB=jarvis
JARVIS_REDIS_URL=redis://localhost:6379/0
JARVIS_QDRANT_URL=http://localhost:6333

# Task Execution
JARVIS_MAX_CONCURRENT_TASKS_PER_USER=25
JARVIS_TASK_MAX_DURATION_SECONDS=300
JARVIS_TASK_MAX_RETRIES=3

# Auth (Placeholder)
JARVIS_JWT_SECRET=dev-secret-change-in-production

# CORS
JARVIS_CORS_ORIGINS=["*"]

# LLM API Keys (uncomment when integrating)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
